{
  "name": "blender-gis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:docs": "pnpm --filter @blender-gis/docs dev",
    "build:docs": "pnpm --filter @blender-gis/docs build",
    "build:design": "pnpm --filter @cii/svelte build",
    "check": "pnpm --filter \"./apps/*\" check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  }
}
